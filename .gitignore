thesis-documents/

# Accidental command/output artifacts
h origin master
ngrok-demo.log
ngrok-demo.err.log

# ---------------------------------------------------------------------------
# Harvested data IS tracked.
#
# Scheduled ingestion runs in CI and commits its output (see
# .github/workflows/scheduled-ingestion.yml), so the commit history is the
# evidence that ingestion ran without gaps. Ignoring these files would defeat
# that, and would also mean a fresh deployment starts with an empty store.
# ---------------------------------------------------------------------------

# Large local artefacts that are rebuilt, never authored
jena-git-project/data/tdb2/
jena-git-project/data/raw/**/*.html
jena-git-project/data/rdf/*.ttl.bak
jena-git-project/data/import/
jena-git-project/output/
jena-git-project/data/reports/
jena-git-project/data/registry/reports/

# Superseded generated RDF files
jena-git-project/eli_metadata.ttl
jena-git-project/eli_metadata_cleaned.ttl
jena-git-project/src/eli_metadata_generated.ttl

# Raw Normattiva downloads (AKN/JSON/ZIP) can be large. Keep the manifest
# (file name + SHA-256 + time) in Git, keep the files themselves local.
jena-git-project/data/raw/normattiva/*/
