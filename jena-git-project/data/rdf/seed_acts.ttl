@prefix eli:     <http://data.europa.eu/eli/ontology#> .
@prefix eli-fc:  <http://publications.europa.eu/resource/authority/eli-in-force/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ilg:     <http://example.org/italian-legislation/ontology#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# Seed data required by CONTEXT.md section 3.1.
#
# The specification names these four acts and says explicitly: do not invent
# placeholder data, use these. They give the platform a real conversion pair to
# demonstrate eli:commences, and a Legge with two Expressions to demonstrate
# version listing.
#
# Two notes on fidelity, so the difference from the specification is a recorded
# decision rather than a silent edit:
#
#  1. CONTEXT.md writes "Legge 22 aprile 2020, n. 27". The act published under
#     redactional code 20G00043 is Legge *24* aprile 2020, n. 27, which is also
#     what the ELI identifier the specification gives (.../2020/04/24/...)
#     encodes. The correct title is used here and the identifier is unchanged.
#  2. Full IRIs are written out rather than using a "gu:" prefix. A Turtle
#     local name may not contain "/" or "#", so gu:id/2020/03/17/... is a
#     syntax error - which is exactly how the first version of this file
#     failed to load.
#  3. Subject concepts and issuing authorities are minted in this project's own
#     namespace as SKOS concepts rather than pointing at EuroVoc identifiers
#     that have not been verified. ARCHITECTURE.md section 4 lists SKOS for
#     exactly this purpose. They exist so that TC-03 - navigating a relation
#     that is not a conversion - has something to navigate.
# ---------------------------------------------------------------------------

# --- Controlled vocabulary -------------------------------------------------

ilg:concept-emergenza-sanitaria
        rdf:type         skos:Concept ;
        skos:prefLabel   "Emergenza sanitaria"@it ;
        rdfs:label       "Public health emergency" .

ilg:concept-sostegno-economico
        rdf:type         skos:Concept ;
        skos:prefLabel   "Sostegno economico"@it ;
        rdfs:label       "Economic support" .

ilg:authority-parlamento
        rdf:type         skos:Concept ;
        skos:prefLabel   "Parlamento della Repubblica Italiana"@it ;
        rdfs:label       "Parliament of the Italian Republic" .

ilg:authority-governo
        rdf:type         skos:Concept ;
        skos:prefLabel   "Governo della Repubblica Italiana"@it ;
        rdfs:label       "Government of the Italian Republic" .

# --- Pair 1: Decreto-legge 18/2020 converted by Legge 27/2020 --------------

