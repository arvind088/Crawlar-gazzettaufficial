# A trimmed copy of real data, ELI only: D.L. 18/2020 (Cura Italia), the law that
# converted it (L. 27/2020) and one act outside the corpus.

# Layer 1: the acts.
<https://example.it/eli/id/2020/03/17/20G00034/sg>
        a eli:LegalResource ;
        dcterms:source <https://dati.normattiva.it/> ;
        eli:id_local "20G00034" ;
        eli:type_document <http://www.gazzettaufficiale.it/eli/tables/resource-type#DECRETO-LEGGE> ;
        eli:date_document "2020-03-17"^^xsd:date ;
        eli:date_publication "2020-03-17"^^xsd:date ;
        eli:first_date_entry_in_force "2020-03-17"^^xsd:date ;
        eli:number "18" ;
        eli:title "Misure di potenziamento del Servizio sanitario nazionale."@it ;
        owl:sameAs <http://www.gazzettaufficiale.it/eli/id/2020/03/17/20G00034/sg> ;
        eli:is_realized_by <https://example.it/eli/id/2020/03/17/20G00034/sg/ita/original> .

<https://example.it/eli/id/2020/03/17/20G00034/sg/ita/original>
        a eli:LegalExpression ; eli:version_date "2020-03-17"^^xsd:date ;
        eli:is_embodied_by <https://example.it/eli/id/2020/03/17/20G00034/sg/ita/original/akn> .
<https://example.it/eli/id/2020/03/17/20G00034/sg/ita/original/akn>
        a eli:Format ; dcterms:source "corpus/2020-03-17_20G00034_ORIGINALE_V0.xml" .

<https://example.it/eli/id/2020/04/29/20G00045/sg>
        a eli:LegalResource ;
        dcterms:source <https://dati.normattiva.it/> ;
        eli:id_local "20G00045" ;
        eli:type_document <http://www.gazzettaufficiale.it/eli/tables/resource-type#LEGGE> ;
        eli:date_document "2020-04-24"^^xsd:date ;
        eli:date_publication "2020-04-29"^^xsd:date ;
        eli:number "27" ;
        eli:title "Conversione in legge, con modificazioni, del decreto-legge 17 marzo 2020, n. 18."@it ;
        eli:is_realized_by <https://example.it/eli/id/2020/04/29/20G00045/sg/ita/original> .

# Layer 2: a consolidated version of D.L. 18/2020.
<https://example.it/eli/id/2020/03/17/20G00034/sg>
        eli:is_realized_by <https://example.it/eli/id/2020/03/17/20G00034/sg/ita/vigente/2020-04-30> .
<https://example.it/eli/id/2020/03/17/20G00034/sg/ita/vigente/2020-04-30>
        a eli:LegalExpression ; eli:version_date "2020-04-30"^^xsd:date .

# Relations: L. 27/2020 amends (and converts) D.L. 18/2020, whose version of 30 April
# consolidates it; D.L. 18/2020 changes an act outside the corpus.
<https://example.it/eli/id/2020/04/29/20G00045/sg>
        eli:amends <https://example.it/eli/id/2020/03/17/20G00034/sg> .
<https://example.it/eli/id/2020/03/17/20G00034/sg/ita/vigente/2020-04-30>
        eli:consolidates <https://example.it/eli/id/2020/04/29/20G00045/sg> .
<https://example.it/eli/id/2020/03/17/20G00034/sg>
        eli:changes <https://example.it/eli/ext/decreto_legislativo/2001-03-30/165> .

<https://example.it/eli/ext/decreto_legislativo/2001-03-30/165>
        a eli:LegalResource ;
        rdfs:label "DECRETO_LEGISLATIVO 2001-03-30 n. 165" ;
        eli:type_document <http://www.gazzettaufficiale.it/eli/tables/resource-type#DECRETO_LEGISLATIVO> ;
        eli:date_document "2001-03-30"^^xsd:date ;
        eli:number "165" .
