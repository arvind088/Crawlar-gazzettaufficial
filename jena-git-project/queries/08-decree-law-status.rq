# Decree-laws by conversion status
# How many decree-laws are converted, repealed, pending, awaiting the law's text or not converted (latest check of each).
PREFIX ilg: <http://example.org/italian-legislation/ontology#>

SELECT ?status (COUNT(?decree) AS ?decreeLaws)
WHERE {
  ?check a ilg:ConversionCheck ;
         ilg:assesses ?decree ;
         ilg:assessedOn ?on ;
         ilg:conversionStatus ?status .
  FILTER NOT EXISTS {
    ?newer a ilg:ConversionCheck ; ilg:assesses ?decree ; ilg:assessedOn ?later .
    FILTER (?later > ?on)
  }
}
GROUP BY ?status
ORDER BY DESC(?decreeLaws)
