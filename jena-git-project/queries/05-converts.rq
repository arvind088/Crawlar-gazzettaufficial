# Laws that convert decree-laws
# Each conversion law and the decree-law it converts (eli:commences: the law keeps the decree-law in force).
# it: Leggi che convertono decreti-legge
# it: Ogni legge di conversione e il decreto-legge che converte (eli:commences: la legge mantiene in vigore il decreto-legge).
PREFIX eli: <http://data.europa.eu/eli/ontology#>

SELECT ?law ?decree ?decreePublished ?lawPublished
WHERE {
  ?law eli:commences ?decree ;
       eli:date_publication ?lawPublished .
  ?decree eli:date_publication ?decreePublished .
}
ORDER BY DESC(?lawPublished)
LIMIT 50
