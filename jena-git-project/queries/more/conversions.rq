# Every decree-law and the law that converts it, if any (eli:commences: the conversion law keeps the
# decree-law in force; the link comes from the law's title, "Conversione in legge … del decreto-legge …").
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rt: <http://www.gazzettaufficiale.it/eli/tables/resource-type#>

SELECT ?decree ?decreeTitle ?published ?law
WHERE {
  ?decree eli:type_document rt:DECRETO-LEGGE ;
          dcterms:source <https://dati.normattiva.it/> ;
          eli:date_publication ?published .
  OPTIONAL { ?decree eli:title ?decreeTitle }
  OPTIONAL { ?law eli:commences ?decree }
}
ORDER BY DESC(?published)
