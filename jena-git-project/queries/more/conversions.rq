# Every decree-law and the law that converts it, if any: a law whose title says
# "Conversione in legge … del decreto-legge ⟨date⟩, n. ⟨number⟩" and that is linked to it.
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rt: <http://www.gazzettaufficiale.it/eli/tables/resource-type#>

SELECT ?decree ?decreeTitle ?published ?law
WHERE {
  ?decree eli:type_document rt:DECRETO-LEGGE ;
          dcterms:source <https://dati.normattiva.it/> ;
          eli:number ?number ;
          eli:date_publication ?published .
  OPTIONAL { ?decree eli:title ?decreeTitle }
  OPTIONAL {
    ?law eli:type_document rt:LEGGE ;
         eli:title ?title ;
         eli:amends|eli:changes|eli:repeals ?decree .
    FILTER (STRSTARTS(LCASE(STR(?title)), "conversione in legge"))
    FILTER (REGEX(STR(?title), CONCAT("n\\. ?", STR(?number), "([^0-9]|$)")))
  }
}
ORDER BY DESC(?published)
