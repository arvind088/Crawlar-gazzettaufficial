# Which act produced each version of an act, with the evidence
# Example: D.L. 18 dicembre 2020, n. 172 (codice redazionale 20G00196).
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX ilg: <http://example.org/italian-legislation/ontology#>

SELECT ?version ?versionDate ?changingAct ?eventDate ?daysAfterEvent ?startsOnEntryIntoForce ?confirmedByChangeList
WHERE {
  ?act eli:id_local "20G00196" ;
       eli:is_realized_by ?version .
  ?version eli:version_date ?versionDate .
  ?change a ilg:VersionChange ;
          ilg:version ?version ;
          ilg:changingAct ?changingAct ;
          ilg:eventDate ?eventDate ;
          ilg:daysAfterEvent ?daysAfterEvent ;
          ilg:confirmedByChangeList ?confirmedByChangeList .
  OPTIONAL { ?change ilg:startsOnEntryIntoForce ?startsOnEntryIntoForce }
}
ORDER BY ?versionDate ?changingAct
