# Which act(s) each version of an act consolidates (eli:consolidates): the changes it contains.
# Example: D.L. 17 marzo 2020, n. 18 (codice redazionale 20G00034).
PREFIX eli: <http://data.europa.eu/eli/ontology#>

SELECT ?version ?versionDate ?changingAct ?type ?date ?number
WHERE {
  ?act eli:id_local "20G00034" ;
       eli:is_realized_by ?version .
  ?version eli:version_date ?versionDate .
  OPTIONAL {
    ?version eli:consolidates ?changingAct .
    OPTIONAL { ?changingAct eli:type_document ?type ; eli:date_document ?date ; eli:number ?number }
  }
}
ORDER BY ?versionDate ?changingAct
