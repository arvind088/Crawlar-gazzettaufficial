# How many Normattiva acts were confirmed by their Gazzetta Ufficiale page,
# by act type, using each act's latest check. MATCH = type, number, date of
# the act and GU date agree. Earlier checks stay in the store as history.
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX ilg: <http://example.org/italian-legislation/ontology#>

SELECT ?type ?result (COUNT(?act) AS ?acts)
WHERE {
  ?check a ilg:GazzettaCheck ;
         ilg:assesses ?act ;
         ilg:assessedOn ?date ;
         ilg:gazzettaCheck ?result .
  FILTER NOT EXISTS {
    ?newer a ilg:GazzettaCheck ; ilg:assesses ?act ; ilg:assessedOn ?later .
    FILTER (?later > ?date)
  }
  ?act eli:type_document ?type .
}
GROUP BY ?type ?result
ORDER BY ?type ?result
